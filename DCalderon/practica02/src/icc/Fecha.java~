/**metdo para convertir anio en dias
*  @return int - el nuemro de dias en un anio desde el anio 2000
*/
	public int diaXAnio () {
		int anioEnDias;
		int anioOG; 
		anioEnDias = 0;
		anioOG = anio;
		while (anio > 2000){
			anio --;
			if (esBisiesto() == true){
				anioEnDias= anioEnDias + 366;
			}else{
				anioEnDias = anioEnDias + 365;
			}
		}
		asignarAnio(anioOG);
		return anioEnDias;
		
	}
/**metodo para saber la diferencia entre dos fechas 
* @param fechaAC - fecha con la que se decide comparar
* @return int - numero de dias que hay entre ambas fechas
*/

	public int difEnDias(Fecha fechaAC){
	int diasTotalesDef = diaXAnio() + diaXMes() + dia;
	int diasTotalesAC = fechaAC.diaXAnio() +fechaAC.diaXMes() + fechaAC.dia;
		if (diasTotalesDef > diasTotalesAC) {
			return diasTotalesDef - diasTotalesAC;
		}else{
			return diasTotalesAC - diasTotalesDef;
		}	
	}


/**metodo para sumarle o restarle dias en un numero entero a una fecha
* @param diasM - numeri de dias que se le desea restar 
*/
	public void modFecha(int diasM){
		while (diasM > 0){
			dia++;
			if (dia>diaXMes()){
				asignarDia(1);
				mes++;
				if (mes > 12){
					asignarMes(1);
					anio++;
				}
			}
			diasM--;
		}
		
		while(diasM < 0){
			dia--;
			if(dia < 1){
				mes--;
				if	(mes < 1){
					asignarMes(12);
					anio--;
				}
				asignarDia(diaXMes());
			}
			diasM++;
		}
	}

